# Environment variables for Todo Chatbot Kubernetes deployment
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control

# Database connection string (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Groq API key for LLM (get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_api_key_here

# JWT secret for authentication (generate a random 32+ character string)
JWT_SECRET=your-secret-key-min-32-characters-change-this

# Groq API base URL (default: https://api.groq.com/openai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq model name (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# CORS origins (comma-separated, default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum conversation history messages to load
MAX_CONVERSATION_HISTORY=50

# Days before archiving old conversations
CONVERSATION_ARCHIVE_DAYS=90

# LLM request timeout in seconds
LLM_REQUEST_TIMEOUT=30

# Maximum LLM retry attempts
LLM_MAX_RETRIES=3
